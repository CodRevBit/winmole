# WinMole .gitignore

# Security, secrets, and environment configurations
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.pkcs12
*.cer
*.crt
id_rsa*
id_ed25519*
*credentials*
*secret*

# Python & uv build / virtual environment artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.uv/

# Node.js & npm artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local cache & WinMole runtime state
*.log
history.jsonl
config.json
targets.json
.winmole/

# Test outputs
test_temp/
TestResults/
.pester/

# IDE & Editor files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Pre-vibecoding specifications and documentation
docs/

